{
  "sourceLanguage" : "ja",
  "strings" : {
    "Preview: %@" : {
      "shouldTranslate" : false
    },
    "%@さん" : {
      "comment" : "担当者の名前に付ける敬称",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        }
      }
    },
    "%@さんから「%@」にありがとうが届きました" : {
      "comment" : "1つめは送った人の名前、2つめは家事の名前",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@さんから「%2$@」にありがとうが届きました"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ thanked you for “%2$@”"
          }
        }
      }
    },
    "%@さんが家事の完了を記録しました" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ marked a chore as done"
          }
        }
      }
    },
    "%@さんが家事を終えました" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ finished a chore"
          }
        }
      }
    },
    "%lld件の家事が完了しました" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld chore was completed"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld chores were completed"
                }
              }
            }
          }
        }
      }
    },
    "homeauで一緒に家事を管理しませんか？下のリンクから参加できます。" : {
      "comment" : "招待リンクと一緒に共有する文。homeauはアプリ名なので訳さない",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Want to manage chores together on homeau? Join with the link below."
          }
        }
      }
    },
    "「%@」が完了しました" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is done"
          }
        }
      }
    },
    "「%@」（担当：%@）" : {
      "comment" : "1つめは家事の名前、2つめは担当者の名前を並べたもの",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "「%1$@」（担当：%2$@）"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” (done by %2$@)"
          }
        }
      }
    },
    "プレミアムプラン" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium Plan"
          }
        }
      }
    },
    "・" : {
      "comment" : "名前を並べるときの区切り（例: Aさん・Bさん、月曜日・木曜日）",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", "
          }
        }
      }
    },
    "今日もおつかれさまでした" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Great work today"
          }
        }
      }
    },
    "今日終わった家事があります。ふりかえって、ありがとうを伝え合いませんか" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chores got done today. Why not look back and thank each other?"
          }
        }
      }
    },
    "年額プラン" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annual Plan"
          }
        }
      }
    },
    "月額プラン" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
