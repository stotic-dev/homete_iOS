{
  "sourceLanguage" : "ja",
  "strings" : {
    "%@に、ありがとうを伝えました" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks sent for %@."
          }
        }
      }
    },
    "%@はもう終わっています" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is already done."
          }
        }
      }
    },
    "おつかれさまでした。%@を記録しました（+%lldpt）" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nice work! %1$@ is done (+%2$lldpt)."
          }
        }
      }
    },
    "この家事には、ありがとうを伝えられません" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can't say thanks for this chore."
          }
        }
      }
    },
    "どの家事にありがとうを伝えますか？" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which chore do you want to say thanks for?"
          }
        }
      }
    },
    "アプリをアップデートしてから使えます" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update the app to use this."
          }
        }
      }
