    "アプリを開いて、ログインしてから使えます" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the app and sign in to use this."
          }
        }
      }
    },
    "パートナーを招待すると使えます" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invite your partner to use this."
          }
        }
      }
    },
    "今は、ありがとうを伝えられる家事はありません" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are no chores to say thanks for right now."
