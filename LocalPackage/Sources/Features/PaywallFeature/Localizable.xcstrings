{
  "sourceLanguage" : "ja",
  "strings" : {
    "%@" : {
      "comment" : "期間が分からないプランの価格",
      "shouldTranslate" : false
    },
    "%@ / 年" : {
      "comment" : "年額プランの価格",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ / year"
