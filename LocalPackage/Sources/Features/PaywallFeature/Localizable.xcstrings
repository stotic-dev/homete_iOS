{
  "sourceLanguage" : "ja",
  "strings" : {
    "%@" : {
      "comment" : "期間が分からないプランの価格",
      "shouldTranslate" : false
    },
    "%@ / 年" : {
      "comment" : "年額プランの価格",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ / year"
          }
        }
      }
    },
    "%@ / 月" : {
      "comment" : "月額プランの価格",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ / month"
          }
        }
      }
    },
    "1か月あたり%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ per month"
          }
        }
      }
    },
    "1つの家事に%lld枚まで。やり方や仕上がりを同居人と共有できます。" : {
      "comment" : "数字は1つの家事に添えられる写真の枚数",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Up to %lld photo per chore. Share how it's done or how it turned out with your housemates."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Up to %lld photos per chore. Share how it's done or how it turned out with your housemates."
                }
              }
            }
          }
        }
      }
    },
    "3か月より前の家事の記録も、いつでも見られます。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See chores from more than 3 months ago, anytime."
          }
        }
      }
    },
    "OK" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OK"
          }
        }
      }
    },
    "ありがとうございます" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thank you!"
          }
        }
      }
    },
    "いつもの家事を好きなだけ登録できます" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save as many go-to chores as you like"
          }
        }
      }
    },
    "お支払いはApple Accountに請求されます。期間が終わる24時間前までに解約しない限り、サブスクリプションは自動で更新されます。解約は、App Storeのアカウント設定からいつでも行えます。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payment will be charged to your Apple Account. Your subscription renews automatically unless canceled at least 24 hours before the end of the current period. You can cancel anytime in your App Store account settings."
          }
        }
      }
    },
    "すべての記録を振り返れます" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look back on your entire history"
          }
        }
      }
    },
    "バナー広告が消えて、画面がすっきりします。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banner ads go away, so your screen stays clean."
          }
        }
      }
    },
    "プライバシーポリシー" : {
      "localizations" : {
