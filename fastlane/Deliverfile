# The Deliverfile allows you to store various App Store Connect metadata
# For more information, check out the docs
# https://docs.fastlane.tools/actions/deliver/

# Issue #238: リリースパイプラインがCIから無人実行されるようになったため、
# 内容を確認してから手動でApp Store Connect上から提出する運用にする。
# 自動提出が必要になった場合はレビューの上でtrueに戻すこと。
submit_for_review(false)
run_precheck_before_submit(false)
force(true)
# 既定ではASCに上がっているスクリーンショットを残したまま足すだけで、差し替え・ファイル名の変更をすると
# 古いものが残る。fastlane/screenshots/ にあるロケールのスクリーンショットを全部消してから上げ直す
# （ファイルが無いロケールのスクリーンショットは消さない）
overwrite_screenshots(true)
submission_information(
    { export_compliance_uses_encryption: false }
)