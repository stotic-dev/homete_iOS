rules_version = '2';

// hometeのFirestoreセキュリティルール
//
// 設計方針:
//
// 1. 「認証済みか」ではなく「同居人グループのメンバーか」で判定する。
//    Sign in with Appleで誰でもアカウントを作れるため、`request.auth != null` だけでは
//    第三者が全グループのデータへ到達できてしまう。
//
// 2. 所属判定の根拠はCohabitantドキュメントの`members`だけとする。
//    `Account.cohabitantId`は本人が自由に書き換えられるため、権限判定には使わない。
//    （グループIDを推測できても、membersに入っていなければ何も読めない）
//
// 3. 明示的に許可したパス以外はすべて拒否する。
//    未使用の`DailyHouseworks`や、クライアントに開かない`Invitation`は閉じたままにする。
//
// Cloud Functions は Admin SDK 経由のためこのルールを迂回する。
// クライアントに導線が無い操作（Account/Cohabitantの削除など）は、Functions側に任せて
// ここでは閉じている。

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 指定した同居人グループのmembersを返す。
    // ドキュメントが存在しない場合はnull参照でルール評価がエラーになり、拒否される。
    function cohabitantMembers(cohabitantId) {
      return get(
        /databases/$(database)/documents/Cohabitant/$(cohabitantId)
      ).data.members;
    }

    function isCohabitantMember(cohabitantId) {
      return isSignedIn()
        && cohabitantId is string
        && request.auth.uid in cohabitantMembers(cohabitantId);
    }

    // 家事メモ（家事・毎月のテンプレート・いつもの家事が持つ`memo`）の検査（ADR-0033）
    //
    // プランごとの文字数上限（無料200文字など）はクライアントで判定し、ここでは見ない。
    // テンプレートやいつもの家事は、書いた人とそこから家事を作る人のプランが違いうるため、
    // 書き込んだ人のプランで判定すると、同居人が家事を完了できなくなるなどの食い違いが起きる。
    // ここではプランに依存しない次の2つだけを検査する。

    // 1ドキュメント1MiBの制限からドキュメントを守る安全上限。
    // テキストはクライアントの上限（5,000文字）より大きく取る。Swiftの文字数（書記素クラスタ）と
    // `size()`では絵文字などの数え方が違うため。
    // チェックリストの項目名の長さは、配列を走査できないため検査しない（1MiBの制限で頭打ちになる）。
    function isValidMemo(data) {
      return !('memo' in data)
        || (
          data.memo is map
          && data.memo.text is string
          && data.memo.text.size() <= 20000
          && data.memo.checklist is list
          && data.memo.checklist.size() <= 100
        );
    }

    // 旧バージョンのアプリは`memo`を知らずにドキュメント全体を上書きするため、メモが消える更新を拒否する。
    // 新しいアプリはメモを消したときも空の`memo`を残すので、この条件に掛からない。
    function keepsMemo() {
      return !('memo' in resource.data) || 'memo' in request.resource.data;
    }

    // ドキュメントIDはFirebase Authのuid。`id`フィールドにも同じ値を持つ
    // （Functionsが `where("id", "==", uid)` で引くため）。
    match /Account/{userId} {

      // 本人に加えて、同じグループのメンバーも読める。
      // CohabitantStoreがメンバー一覧のuserNameを引くために他メンバーのAccountをgetするため
      // （LocalPackage/Sources/HometeDomain/Cohabitant/CohabitantStore.swift）。
      //
      // ルールはフィールド単位の読み取り制限ができないので、同居人にはfcmTokenも
      // 見えてしまう点は許容している。グループ外からは読めない。
      allow get: if isSelf(userId)
                 || (
                   'cohabitantId' in resource.data
                   && isCohabitantMember(resource.data.cohabitantId)
                 );

      // クライアントにAccountを一覧する導線は無い。Functionsは Admin SDK で引く
      allow list: if false;

      allow create, update: if isSelf(userId)
                            && request.resource.data.id == userId;

      // アカウント削除は deleteuserdata (Authトリガー) が Admin SDK で行う
      allow delete: if false;
    }

    match /Cohabitant/{cohabitantId} {

      function isCurrentMember() {
        return isSignedIn() && request.auth.uid in resource.data.members;
      }

      // 書き込み後もドキュメントIDと`id`が一致し、自分がmembersに残ること。
      // Cloud Functions が `where("id", "==", ...)` で引くため、`id`のズレは
      // そのままFunctions側の不具合になる。
      function isValidWrite() {
        return request.resource.data.id == cohabitantId
          && request.resource.data.members is list
          && request.auth.uid in request.resource.data.members;
      }

      allow get: if isCurrentMember();

      // `list`はクエリ内容だけで判定され、ルールから`resource.data.members`を
      // 参照できない（メンバー判定が書けない）。クライアントはグループIDを知っている
      // 前提でドキュメント購読するため、一覧は塞ぐ。
      allow list: if false;

      // P2P登録のリーダーが、自分と同意済みフォロワーを含む新規グループを作る
      // （CohabitantRegistrationProcessingLeader.onReadyRegistration）
      allow create: if isSignedIn() && isValidWrite();

      // メンバーの増減は既存メンバーだけが行える
      allow update: if isCurrentMember() && isValidWrite();

      // グループ削除は deleteuserdata が Admin SDK で行う
      allow delete: if false;

      match /Houseworks/{houseworkId} {
        // NOTE: `expiredAt`（保持期限）はクライアントが登録時に書き込む値のため、
        // ここでは制限していない。保持期限の根拠になる`Account.isPremium`自体が
        // クライアント書き込みであり、ルールだけでは正当性を検証できない。
        // サーバー側でRevenueCatのエンタイトルメントを検証するまでの残存リスク。
        allow read: if isCohabitantMember(cohabitantId);
        allow create: if isCohabitantMember(cohabitantId)
                      && request.resource.data.id == houseworkId
                      && isValidMemo(request.resource.data);
        allow update: if isCohabitantMember(cohabitantId)
                      && request.resource.data.id == houseworkId
                      && isValidMemo(request.resource.data)
                      && keepsMemo();
        allow delete: if isCohabitantMember(cohabitantId);
      }

      match /HouseworkTemplates/{templateId} {
        allow read, write: if isCohabitantMember(cohabitantId);

        // NOTE: 毎週の家事は1ドキュメントに家事を配列で持ち、配列を走査できないため
        // メモの安全上限・消失の拒否を検査していない。旧バージョンのアプリが保存し直すと
        // その曜日の家事のメモが消える残存リスクは、強制アップデートで塞ぐ（ADR-0033）。
        match /Days/{dayOfWeek} {
          allow read, write: if isCohabitantMember(cohabitantId);
        }

        // 毎月繰り返す家事。1ドキュメント = 1家事（ADR-0022）
        match /MonthlyItems/{itemId} {
          allow read, delete: if isCohabitantMember(cohabitantId);
          allow create: if isCohabitantMember(cohabitantId)
                        && isValidMemo(request.resource.data);
          allow update: if isCohabitantMember(cohabitantId)
                        && isValidMemo(request.resource.data)
                        && keepsMemo();
        }

        // テンプレートの編集ロック。ドキュメントIDが編集者のuidで、
        // クライアントは自分のロックしか作成・削除しない
        // （HouseworkTemplateEditStore.startEditing / stopEditing）。
        match /Editors/{editorId} {
          allow read: if isCohabitantMember(cohabitantId);
          allow write: if isCohabitantMember(cohabitantId) && isSelf(editorId);
        }
      }

      // いつもの家事とカスタムカテゴリ。グループのメンバーなら誰でも追加・編集・削除できる。
      // NOTE: 無料プランの件数上限・名前の重複はクライアントでのみ判定している。
      // 上限の根拠になる`Account.isPremium`がクライアント書き込みのため、
      // ここでは検証できない（Houseworksの`expiredAt`と同じ残存リスク）。
      match /FrequentHouseworks/{itemId} {
        allow read, delete: if isCohabitantMember(cohabitantId);
        allow create: if isCohabitantMember(cohabitantId)
                      && request.resource.data.id == itemId
                      && isValidMemo(request.resource.data);
        allow update: if isCohabitantMember(cohabitantId)
                      && request.resource.data.id == itemId
                      && isValidMemo(request.resource.data)
                      && keepsMemo();
      }

      match /FrequentHouseworkCategories/{categoryId} {
        allow read, delete: if isCohabitantMember(cohabitantId);
        allow create, update: if isCohabitantMember(cohabitantId)
                              && request.resource.data.id == categoryId;
      }
    }

    // Invitationは招待トークンそのものがドキュメントIDになっているため、
    // クライアントから読めると有効なトークンを列挙できてしまう。書き込みを許すと
    // cohabitantId / expiresAt を差し替えてcallableの検証を迂回できるため、
    // クライアントには読み書きとも一切開かない。
    // 招待の発行・参加は issuecohabitantinvitation / joincohabitant (Admin SDK) が行う。
    match /Invitation/{token} {
      allow read, write: if false;
    }
  }
}
