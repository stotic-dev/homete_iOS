# scripts/appstoreconnect.sh で使用するApp Store Connect APIの認証情報
# fastlane/Fastfile の app_store_connect_api_key と同じ環境変数名です
#
# 使い方:
#   cp scripts/appstoreconnect.env.example scripts/appstoreconnect.env   # 実際の値を設定
#   source scripts/appstoreconnect.env && scripts/appstoreconnect.sh subscriptions get <subscription_id>
#
# scripts/appstoreconnect.env は絶対にコミットしないこと

# App Store Connect APIキーのKey ID
# 取得方法: App Store Connect > ユーザーとアクセス > 統合 > App Store Connect API > キーを生成
export ASC_KEY_ID=XXXXXXXXXX

# App Store Connect APIキーのIssuer ID
export ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 秘密鍵ファイル(.p8)へのパス（ダウンロードは発行時の1回のみ可能）
export ASC_API_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
