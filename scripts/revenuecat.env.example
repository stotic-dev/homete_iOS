# scripts/revenuecat.sh で使用するRevenueCat REST API v2の認証情報
#
# 使い方:
#   cp scripts/revenuecat.env.example scripts/revenuecat.env   # 実際の値を設定
#   source scripts/revenuecat.env && scripts/revenuecat.sh products list
#
# scripts/revenuecat.env は絶対にコミットしないこと（.gitignoreの "*.env" 系ルールに追加推奨）

# RevenueCat Secret API Key（sk_から始まる）
# 取得方法: RevenueCat Dashboard > Project Settings > API keys > + New secret API key
# Project Adminのみ発行可能。サーバー/ローカル環境変数としてのみ扱うこと
export REVENUECAT_SECRET_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RevenueCat Project ID
# 取得方法: RevenueCat Dashboard > Project Settings、またはURL (app.revenuecat.com/projects/{project_id}/...)
export REVENUECAT_PROJECT_ID=proj_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
